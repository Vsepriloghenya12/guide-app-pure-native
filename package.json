{
  "name": "guide-app-native-connected",
  "version": "1.0.8",
  "private": true,
  "workspaces": [
    "server"
  ],
  "scripts": {
    "dev": "npm run dev --workspace server",
    "dev:server": "npm run dev --workspace server",
    "build": "npm run build --workspace server",
    "build:server": "npm run build --workspace server",
    "start": "npm run start --workspace server",
    "mobile:start": "cd mobile && npm run start",
    "mobile:android": "cd mobile && npm run android",
    "mobile:ios": "cd mobile && npm run ios",
    "mobile:prebuild": "cd mobile && npm run prebuild",
    "mobile:doctor": "cd mobile && npm run doctor",
    "apk:configure": "cd mobile && eas init",
    "apk:build": "cd mobile && eas build -p android --profile preview",
    "android:apk": "cd mobile && eas build -p android --profile preview --clear-cache",
    "ios:preview": "cd mobile && eas build -p ios --profile preview --clear-cache",
    "mobile:install": "cd mobile && npm install"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
