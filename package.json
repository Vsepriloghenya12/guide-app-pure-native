{
  "name": "guide-app-pure-native",
  "version": "0.2.8-sdk54-visual-fixes-v8",
  "private": true,
  "workspaces": [
    "server",
    "mobile"
  ],
  "scripts": {
    "build": "npm run build:server",
    "dev:server": "npm run dev --workspace server",
    "start": "npm run start --workspace server",
    "build:server": "npm run build --workspace server",
    "mobile:start": "npm run start --workspace mobile",
    "mobile:android": "npm run android --workspace mobile",
    "mobile:ios": "npm run ios --workspace mobile",
    "mobile:prebuild": "npm run prebuild --workspace mobile",
    "mobile:doctor": "npm run doctor --workspace mobile",
    "apk:build": "cd mobile && npx eas build -p android --profile preview",
    "apk:configure": "cd mobile && npx eas init"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
