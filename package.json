{
  "name": "guide-app-native-connected",
  "version": "0.3.1-railway-workspace-fix",
  "private": true,
  "workspaces": [
    "server",
    "webapp"
  ],
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names web,api \"npm run dev --workspace webapp\" \"npm run dev --workspace server\"",
    "dev:server": "npm run dev --workspace server",
    "dev:web": "npm run dev --workspace webapp",
    "build": "npm run build --workspace webapp && npm run build --workspace server",
    "build:server": "npm run build --workspace server",
    "start": "npm run start --workspace server",
    "mobile:start": "cd mobile && npm run start",
    "mobile:android": "cd mobile && npm run android",
    "mobile:ios": "cd mobile && npm run ios",
    "mobile:prebuild": "cd mobile && npm run prebuild",
    "mobile:doctor": "cd mobile && npm run doctor",
    "apk:configure": "cd mobile && eas init",
    "apk:build": "cd mobile && eas build -p android --profile preview"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
