
NODE_ENV=production
PORT=3001
BYBIT_CATEGORY=linear
MARKET_QUOTE_COIN=USDT
MARKET_TIMEFRAMES=15,60
SCAN_INTERVAL_MS=180000
HISTORY_LIMIT=1000
CORS_ORIGIN=*
STORAGE_FILE=./data/market-state.json
ACCOUNT_SIZE_USD=100
RISK_PER_TRADE_PCT=1
MIN_CONFIDENCE_ACTIONABLE=0.55
MAX_SYMBOLS_TO_ANALYZE=20
MIN_TURNOVER_24H_USD=2000000
MAX_SPREAD_PCT=0.45
PAPER_STARTING_BALANCE_USD=100
PAPER_MAX_CLOSED_TRADES=1000
SIMULATION_FEE_PCT=0.055
BACKTEST_CANDLES=320
BACKTEST_WARMUP=220
BACKTEST_MAX_SYMBOLS=8
BACKTEST_MAX_HOLD_CANDLES=36
BACKTEST_STARTING_BALANCE_USD=100
AI_ANALYSIS_ENABLED=false
AI_ANALYZE_HOLD_SIGNALS=false
OPENAI_MODEL=gpt-5.4-mini
PUSH_ENABLED=true
PUSH_SUBJECT=mailto:nerealniylubovnik123@gmail.com
PUSH_MIN_REPEAT_MS=21600000
PUSH_MAX_EVENTS=500
# Для стабильных push-подписок на Railway лучше задать постоянные VAPID-ключи.
# Сгенерировать без внешних пакетов: npm run generate:vapid
VAPID_PUBLIC_KEY=32
VAPID_PRIVATE_KEY=32

# Map tiles provider for MapLibre.
# For development fallback you can use:
# VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
#
# For production use a proper tile provider:
# MapTiler, Geoapify, Stadia Maps, self-hosted OpenMapTiles/PMTiles, etc.
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
