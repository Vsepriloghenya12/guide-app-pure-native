# Danang Guide backend / Railway
NODE_ENV=production
PORT=8080
PUBLIC_APP_URL=https://your-railway-app.up.railway.app

# Owner CMS auth
OWNER_PASSWORD=change-me
OWNER_SESSION_SECRET=replace-with-long-random-string
AUTH_SESSION_SECRET=replace-with-another-long-random-string

# Cookies / native auth
NATIVE_APP_MODE=true
COOKIE_SECURE=true
COOKIE_SAME_SITE=None
# Optional, comma-separated allowed origins if you need to restrict CORS.
CORS_ALLOWED_ORIGINS=

# Persistent uploads. On Railway use a volume path, for example /data/uploads.
UPLOADS_DIR=/data/uploads

# Web map tiles
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# Optional only when webapp calls a separate API during local development.
VITE_API_BASE_URL=
VITE_API_PROXY_TARGET=http://127.0.0.1:8080
VITE_DEV_HOST=127.0.0.1
VITE_DEV_PORT=5180
VITE_PREVIEW_PORT=4180

# Google auth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Telegram auth
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_BOT_ID=

# Apple auth
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Native Android package used by auth return flow.
NATIVE_ANDROID_PACKAGE=com.realone14.guideappnativeconnected
# Optional mobile map tiles. Do not use tile.openstreetmap.org directly in APK.
EXPO_PUBLIC_MAP_TILE_URL=https://a.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}.png
