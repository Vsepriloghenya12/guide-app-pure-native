# Railway / API server
NODE_ENV=production
PUBLIC_APP_URL=https://your-api.up.railway.app
PORT=8080
DATABASE_URL=
UPLOADS_DIR=/data/uploads
SYNC_DEFAULT_CONTENT_ON_START=false

# Owner API / CMS security
OWNER_PASSWORD=change-this-owner-password
OWNER_SESSION_SECRET=change-this-long-random-owner-secret
AUTH_SESSION_SECRET=change-this-separate-long-random-user-secret

# Native app API access
NATIVE_APP_MODE=true
COOKIE_SAME_SITE=None
COOKIE_SECURE=true
CORS_ALLOWED_ORIGINS=exp://localhost:8081,http://localhost:8081,http://127.0.0.1:8081

# Optional auth providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
TELEGRAM_BOT_USERNAME=
TELEGRAM_BOT_TOKEN=

# AI assistant - server only
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
AI_RATE_LIMIT_WINDOW_MS=60000
AI_RATE_LIMIT_MAX_REQUESTS=18
