# Адрес backend на Railway. Без этого установленный APK будет работать только на локальных seed-данных.
EXPO_PUBLIC_API_BASE_URL=https://your-real-railway-backend.up.railway.app

# Google Maps Android API key. Нужен для карты в standalone APK.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_android_api_key
