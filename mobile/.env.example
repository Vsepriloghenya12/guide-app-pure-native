EXPO_PUBLIC_API_BASE_URL=https://guide-app-pure-native-production.up.railway.app

# Google Maps Android/iOS SDK API key (react-native-maps).
# Обязателен для standalone-сборок (APK/IPA); в Expo Go на Android карта работает без него.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

EXPO_PUBLIC_TELEGRAM_BOT_ID=

# Set to true only after Firebase/FCM is configured for Android push notifications.
EXPO_PUBLIC_PUSH_NOTIFICATIONS_ENABLED=false
