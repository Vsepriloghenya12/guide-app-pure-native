{
  "cli": {
    "version": ">= 13.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://guide-app-pure-native-production.up.railway.app",
        "EXPO_PUBLIC_MAP_TILE_URL": "https://tile.openstreetmap.org/{z}/{x}/{y}.png"
      },
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      },
      "environment": "preview"
    },
    "production": {
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://guide-app-pure-native-production.up.railway.app",
        "EXPO_PUBLIC_MAP_TILE_URL": "https://tile.openstreetmap.org/{z}/{x}/{y}.png"
      },
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {},
      "environment": "production"
    }
  }
}
